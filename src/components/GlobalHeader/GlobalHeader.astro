---
import DarkModeToggle from "./DarkModeToggle.vue";
import AuthDropdown from "./AuthDropdown.astro";
import GlobalNav from "./GlobalNav.vue";
---

<header role="banner">
  <img src="/favicon.svg" alt="Book logo" />
  <h1>Aileen's Bookshelf</h1>
  <div class="nav-right">
    <GlobalNav />
    <DarkModeToggle client:load />
    <AuthDropdown server:defer />
  </div>
</header>

<style scoped>
  header {
    align-items: center;
    display: flex;
    margin-bottom: 32px;
    padding: 8px 16px;
  }

  img {
    height: 1.5rem;
    margin-right: 4px;
  }

  h1 {
    font-size: 1.25rem;
    line-height: normal;
    margin-right: 32px;
  }

  .nav-right {
    align-items: center;
    display: flex;
    margin-left: auto;
  }

  .SeparatorRoot {
    background-color: var(--color-green-900);
  }
  .SeparatorRoot[data-orientation="horizontal"] {
    height: 1px;
    width: 100%;
  }
  .SeparatorRoot[data-orientation="vertical"] {
    height: 100%;
    width: 1px;
  }
</style>
